# RALabs web-public — Vite build → nginx
FROM node:20-alpine AS build
WORKDIR /app
COPY web-public/package.json web-public/package-lock.json* ./
RUN npm install
COPY web-public/ ./
RUN npm run build

FROM nginx:alpine
COPY web-public/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
