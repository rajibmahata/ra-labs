# RALabs deployment configuration
# Copy this file to /opt/ralabs/.env on the VPS and fill in the values,
# OR let the GitHub Actions pipeline generate it from secrets (recommended).
# This file is NOT committed to the repository with real values.

ASPNETCORE_ENVIRONMENT=Production

# ── SQL Server (Express) — production database ──
# Credentials injected as runtime env vars only; never in committed files.
DB_HOST=169.58.112.52
DB_PORT=1433
DB_NAME=RALabsDb
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# ── JWT signing secret — REQUIRED, at least 32 characters ──
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=RALabs
JWT_AUDIENCE=RALabs

# Browser origin the API accepts
ALLOWED_ORIGIN=https://example.com

# ── SMTP (lead notifications, invites) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@ralabs.dev
SMTP_FROM_NAME=R&A Labs
SMTP_ADMIN=

# ── GitHub sync token (public data works without it; a token raises rate limits) ──
GITHUB_TOKEN=

# ── Seed demo content on first startup? ──
SEED_ON_STARTUP=false

# ── Domain the gateway serves (also used by SSL scripts) ──
APP_DOMAIN=example.com
CERT_EMAIL=admin@example.com
